{
  "name": "my-nuxt-app",
  "version": "1.0.0",
  "description": "Kurulush POS — киоск кассира и кассы самообслуживания",
  "author": "Kurulush <support@kurulush.store>",
  "type": "module",
  "private": true,
  "main": "electron-main.cjs",
  "scripts": {
    "build": "nuxt build",
    "build:laravel": "NUXT_TARGET=laravel NUXT_PUBLIC_API_BASE=/api nuxt generate && rm -rf ../Online-Store_back/public/_nuxt ../Online-Store_back/public/product ../Online-Store_back/public/blog && cp -r .output/public/. ../Online-Store_back/public/",
    "build:capacitor": "NUXT_TARGET=capacitor NUXT_PUBLIC_API_BASE=https://kurulush-store.fly.dev/api nuxt generate",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "dev": "nuxt dev --host",
    "dev:https": "nuxt dev --host --https",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "electron": "electron electron-main.cjs",
    "electron:local": "electron electron-main.cjs --local",
    "electron:self-service": "electron electron-main.cjs --self-service",
    "kiosk": "google-chrome --kiosk --kiosk-printing --disable-print-preview http://localhost:3000/cashier",
    "kiosk:self-service": "google-chrome --kiosk --kiosk-printing --disable-print-preview http://localhost:3000/self-service",
    "electron:stage": "node scripts/electron-stage.cjs",
    "dist:win": "node scripts/electron-stage.cjs && electron-builder --win",
    "dist:win:local": "set ELECTRON_START_URL=http://localhost:3000&& node scripts/electron-stage.cjs && electron-builder --win -c.nsis.artifactName=${productName}-${version}-local-setup.${ext} -c.portable.artifactName=${productName}-${version}-local-portable.${ext}",
    "dist:linux": "node scripts/electron-stage.cjs && electron-builder --linux",
    "dist:all": "node scripts/electron-stage.cjs && electron-builder --win --linux",
    "release:win": "node scripts/electron-stage.cjs && electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.kurulush.pos",
    "productName": "Kurulush POS",
    "electronVersion": "31.7.7",
    "publish": [
      {
        "provider": "github",
        "owner": "REPLACE_WITH_GITHUB_OWNER",
        "repo": "kurulush-pos-releases",
        "releaseType": "release"
      }
    ],
    "files": [
      "electron-main.cjs",
      "electron-preload.cjs",
      "app-config.json",
      "src-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "app": "electron-app",
      "buildResources": "build-resources",
      "output": "release"
    },
    "icon": "build-resources/icon.png",
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Kurulush POS"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@nuxtjs/bootstrap": "^0.0.1",
    "@nuxtjs/robots": "^6.1.5",
    "@nuxtjs/sitemap": "^8.3.4",
    "@pinia/nuxt": "^0.11.3",
    "@popperjs/core": "^2.11.8",
    "@zxing/browser": "^0.2.1",
    "axios": "^1.16.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "laravel-echo": "^2.3.7",
    "nuxt": "^4.2.2",
    "pdfmake": "^0.2.20",
    "pusher-js": "^8.5.0",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/uuid": "^10.0.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
