{
  "name": "my-nuxt-app",
  "version": "1.0.0",
  "description": "Kurulush POS — киоск кассира и кассы самообслуживания",
  "author": "Kurulush <support@kurulush.store>",
  "type": "module",
  "private": true,
  "main": "electron-main.cjs",
  "scripts": {
    "build": "nuxt build",
    "build:laravel": "NUXT_TARGET=laravel NUXT_PUBLIC_API_BASE=/api nuxt generate && rm -rf ../Online-Store_back/public/_nuxt && cp -r .output/public/. ../Online-Store_back/public/",
    "build:capacitor": "NUXT_TARGET=capacitor NUXT_PUBLIC_API_BASE=https://online-store-back.fly.dev/api nuxt generate",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "dev": "nuxt dev --host",
    "dev:https": "nuxt dev --host --https",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "electron": "electron electron-main.cjs --no-sandbox",
    "electron:self-service": "electron electron-main.cjs --no-sandbox --self-service",
    "kiosk": "google-chrome --kiosk --kiosk-printing --disable-print-preview http://localhost:3000/cashier",
    "kiosk:self-service": "google-chrome --kiosk --kiosk-printing --disable-print-preview http://localhost:3000/self-service",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --win --linux"
  },
  "build": {
    "appId": "com.kurulush.pos",
    "productName": "Kurulush POS",
    "files": [
      "electron-main.cjs",
      "electron-preload.cjs",
      "src-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@nuxtjs/bootstrap": "^0.0.1",
    "@nuxtjs/robots": "^6.1.5",
    "@nuxtjs/sitemap": "^8.3.4",
    "@pinia/nuxt": "^0.11.3",
    "@popperjs/core": "^2.11.8",
    "@zxing/browser": "^0.2.1",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "jsbarcode": "^3.12.3",
    "laravel-echo": "^2.3.7",
    "nuxt": "^4.2.2",
    "pusher-js": "^8.5.0",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^10.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9"
  }
}
